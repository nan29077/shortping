PORT=3033
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3033
# Unset DATABASE_URL for local SQLite. AWS: PostgreSQL on RDS.
# DATABASE_URL=postgresql://shortping:password@localhost:5432/shortping
ENABLE_DEMO=true
# Production requires ENABLE_DEMO=false and HTTPS.
# DATABASE_URL(PostgreSQL)을 쓰면 데모는 ENABLE_DEMO=true로 직접 켤 때만 켜져요(운영 DB에 샘플 · 테스트 로그인이 생기지 않게).
ANDROID_STORE_URL=
IOS_STORE_URL=
# 로드밸런서(ALB)·Cloudflare 등 프록시 뒤에서 실행할 때 프록시 단계 수(보통 1).
# 비워 두면 모든 요청이 프록시 IP 하나로 보여 요청 제한(분당 240회)이 전체 사용자 공용이 됩니다.
# TRUST_PROXY_HOPS=1
# 숏핑 스튜디오: AI 공급사 API 키 암호화용 비밀값(32자 이상). 운영에서는 필수.
# AI_SECRET_KEY=
# 모바일 앱(토큰 로그인): 앱을 빌드할 때 운영 서버 주소를 넣어요(예: VITE_API_ORIGIN=https://shortping.kr npm run mobile:sync).
# VITE_API_ORIGIN=
# 앱 밖으로 공유할 공개 웹 주소(예: https://shortping.kr). 비우면 네이티브 앱은 VITE_API_ORIGIN을 사용합니다.
# VITE_PUBLIC_ORIGIN=
# 앱 화면의 출처(기본: capacitor://localhost, https://localhost, http://localhost). 더 필요하면 쉼표로 추가.
# APP_CLIENT_ORIGINS=
# 앱 영상 주소용 미디어 토큰 서명 비밀값(비우면 DB에 한 번 만들어 저장). 서버를 여러 대 띄우면 같은 값을 넣어 주세요.
# MEDIA_TOKEN_SECRET=
# ── 저장 위치 ──────────────────────────────────────────────
# SQLite 파일 · 개발용 암호화 키를 두는 폴더(기본: ./data)
# DATA_DIR=
# 업로드한 영상 · 이미지 · 자막 폴더(기본: ./uploads). 합성 작업 프로세스도 같은 값을 써야 해요.
# UPLOAD_DIR=
# ── 합성 · 미디어 ─────────────────────────────────────────
# external이면 웹 서버는 합성을 대기열에만 넣고, `npm run worker` 프로세스가 처리해요.
# COMPOSE_WORKER=
# 합성 동시 처리 수(1~4, 기본 1)
# COMPOSE_CONCURRENCY=1
# ffmpeg 실행 파일 경로(비우면 PATH의 ffmpeg, 개발에서는 설치된 ffmpeg-static도 찾아요)
# FFMPEG_PATH=
# ── 숏핑 스튜디오 운영 값 ────────────────────────────────
# 프로젝트당 하루 자동 번역 작업 상한(한국 시간 기준, 기본 300)
# TRANSLATE_DAILY_LIMIT=300
# 썸네일 A/B: 후보마다 이 노출 수를 넘겨야 승자를 정해요(기본 300)
# AB_MIN_IMPRESSIONS=300
# ── 개발 · 테스트 전용 ───────────────────────────────────
# 모의 AI 공급사의 응답 지연(ms, 기본 0)
# AI_MOCK_DELAY_MS=0
# `npm run test:pg`가 테스트마다 새 데이터베이스를 만들 PostgreSQL 관리자 주소
# TEST_PG_ADMIN_URL=postgres://postgres@127.0.0.1:5432/postgres
