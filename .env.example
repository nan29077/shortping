PORT=3033
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3033
# Unset DATABASE_URL for local SQLite. AWS: PostgreSQL on RDS.
# DATABASE_URL=postgresql://shortping:password@localhost:5432/shortping
ENABLE_DEMO=true
# Production requires ENABLE_DEMO=false and HTTPS.
ANDROID_STORE_URL=
IOS_STORE_URL=
# 로드밸런서(ALB)·Cloudflare 등 프록시 뒤에서 실행할 때 프록시 단계 수(보통 1).
# 비워 두면 모든 요청이 프록시 IP 하나로 보여 요청 제한(분당 240회)이 전체 사용자 공용이 됩니다.
# TRUST_PROXY_HOPS=1
# 숏핑 스튜디오: AI 공급사 API 키 암호화용 비밀값(32자 이상). 운영에서는 필수.
# AI_SECRET_KEY=
# 모바일 앱(토큰 로그인): 앱을 빌드할 때 운영 서버 주소를 넣어요(예: VITE_API_ORIGIN=https://shortping.kr npm run mobile:sync).
# VITE_API_ORIGIN=
# 앱 화면의 출처(기본: capacitor://localhost, https://localhost, http://localhost). 더 필요하면 쉼표로 추가.
# APP_CLIENT_ORIGINS=
# 앱 영상 주소용 미디어 토큰 서명 비밀값(비우면 DB에 한 번 만들어 저장). 서버를 여러 대 띄우면 같은 값을 넣어 주세요.
# MEDIA_TOKEN_SECRET=
